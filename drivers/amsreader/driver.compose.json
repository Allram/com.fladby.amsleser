{
  "name": {
    "en": "AMS reader",
    "no": "AMS-leser"
  },
  "class": "sensor",
  "capabilities": [
    "measure_power",
    "meter_power.imported",
    "meter_power.exported",
    "ams_day_import",
    "ams_day_export",
    "measure_voltage.l1",
    "measure_voltage.l2",
    "measure_voltage.l3",
    "measure_current.l1",
    "measure_current.l2",
    "measure_current.l3",
    "ams_hour_usage",
    "ams_month_max",
    "ams_threshold"
  ],
  "capabilitiesOptions": {
    "meter_power.imported": {
      "title": {
        "en": "Imported energy",
        "no": "Importert energi"
      },
      "decimals": 2
    },
    "meter_power.exported": {
      "title": {
        "en": "Exported energy",
        "no": "Eksportert energi"
      },
      "decimals": 2
    },
    "measure_voltage.l1": {
      "title": {
        "en": "Voltage L1",
        "no": "Spenning L1"
      }
    },
    "measure_voltage.l2": {
      "title": {
        "en": "Voltage L2",
        "no": "Spenning L2"
      }
    },
    "measure_voltage.l3": {
      "title": {
        "en": "Voltage L3",
        "no": "Spenning L3"
      }
    },
    "measure_current.l1": {
      "title": {
        "en": "Current L1",
        "no": "Strøm L1"
      }
    },
    "measure_current.l2": {
      "title": {
        "en": "Current L2",
        "no": "Strøm L2"
      }
    },
    "measure_current.l3": {
      "title": {
        "en": "Current L3",
        "no": "Strøm L3"
      }
    },
    "measure_power.l1": {
      "title": {
        "en": "Power L1",
        "no": "Effekt L1"
      }
    },
    "measure_power.l2": {
      "title": {
        "en": "Power L2",
        "no": "Effekt L2"
      }
    },
    "measure_power.l3": {
      "title": {
        "en": "Power L3",
        "no": "Effekt L3"
      }
    }
  },
  "energy": {
    "cumulative": true,
    "cumulativeImportedCapability": "meter_power.imported",
    "cumulativeExportedCapability": "meter_power.exported"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "pair": [
    {
      "id": "connect"
    }
  ],
  "settings": [
    {
      "id": "address",
      "type": "text",
      "label": {
        "en": "IP address or host name",
        "no": "IP-adresse eller vertsnavn"
      },
      "value": "",
      "hint": {
        "en": "The address of the AMS reader on your network. Readers found automatically follow a new address by themselves.",
        "no": "Adressen til AMS-leseren på nettverket. Lesere som ble funnet automatisk, følger selv med når adressen endrer seg."
      }
    },
    {
      "id": "username",
      "type": "text",
      "label": {
        "en": "Username",
        "no": "Brukernavn"
      },
      "value": "",
      "hint": {
        "en": "Only needed when the web page of the reader is password protected.",
        "no": "Trengs bare når nettsiden til leseren er passordbeskyttet."
      }
    },
    {
      "id": "password",
      "type": "password",
      "label": {
        "en": "Password",
        "no": "Passord"
      },
      "value": ""
    },
    {
      "id": "poll_interval",
      "type": "number",
      "label": {
        "en": "Poll interval",
        "no": "Oppdateringsintervall"
      },
      "units": {
        "en": "seconds",
        "no": "sekunder"
      },
      "value": 10,
      "min": 5,
      "max": 300,
      "hint": {
        "en": "How often Homey reads the reader. The meter sends new values every 2 to 10 seconds.",
        "no": "Hvor ofte Homey leser av leseren. Måleren sender nye verdier hvert 2. til 10. sekund."
      }
    },
    {
      "id": "estimate_l2",
      "type": "checkbox",
      "value": true,
      "label": {
        "en": "Estimate current L2",
        "no": "Anslå strøm L2"
      },
      "hint": {
        "en": "Meters on IT networks (230 V without neutral) do not measure the current on L2. When this is on, it is estimated from L1 and L3 as if the load were evenly spread over the phases, so treat it as a guide only.",
        "no": "Målere på IT-nett (230 V uten nøytralleder) måler ikke strømmen på L2. Når dette er på, anslås den ut fra L1 og L3 som om lasten var jevnt fordelt på fasene, så se på den som en pekepinn."
      }
    }
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "discovery": "amsreader"
}

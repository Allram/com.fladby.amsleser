    "ams_threshold": {
      "type": "number",
      "title": {
        "en": "Capacity step",
        "no": "Effekttrinn"
      },
      "units": {
        "en": "kW"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/peak.svg"
    }
  },
  "discovery": {
    "amsreader": {
      "type": "ssdp",
      "ssdp": {
        "search": "upnp:rootdevice"
      },
      "id": "{{headers.usn}}",
      "conditions": [
        [
          {
            "field": "headers.server",
            "match": {
              "type": "regex",
              "value": "AMS reader"
            }
          }
        ]
      ]
    }
  }
}
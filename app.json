  "platforms": [
    "local"
  ],
  "name": {
    "en": "AMS reader",
    "no": "AMS-leser"
  },
  "description": {
    "en": "Your power use, live.",
    "no": "Strømforbruket ditt, direkte."
  },
  "category": [
    "energy"
  ],
  "tags": {
    "en": [
      "AMS",
      "HAN",
      "Smart meter",
      "Power meter",
      "Energy",
      "Solar",
      "Capacity tariff",
      "amsleser"
    ],
    "no": [
      "AMS",
      "HAN",
      "Strømmåler",
      "Smartmåler",
      "Energi",
      "Solceller",
      "Effekttrinn",
      "Nettleie",
      "amsleser"
    ]
  },
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Vegard Fladby",
    "email": "vegard.fladby@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/Allram/com.fladby.amsleser/issues"
  },
  "flow": {
    "triggers": [
      {
        "id": "meter_lost",
        "title": {
          "en": "Lost contact with the meter",
          "no": "Mistet kontakt med måleren"
        },
        "hint": {
          "en": "The reader is online, but no data has arrived from the meter for 30 seconds.",
          "no": "Leseren svarer, men har ikke fått data fra måleren på 30 sekunder."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=amsreader"
          }
        ]
      },
      {
        "id": "meter_restored",
        "title": {
          "en": "Contact with the meter restored",
          "no": "Kontakt med måleren er tilbake"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=amsreader"
          }
        ]
      },
      {
        "id": "hour_usage_exceeded",
        "title": {
          "en": "Usage this hour passed a limit",
          "no": "Forbruket denne timen passerte en grense"
        },
        "titleFormatted": {
          "en": "Usage this hour passed [[kwh]] kWh",
          "no": "Forbruket denne timen passerte [[kwh]] kWh"
        },
        "tokens": [
          {
            "name": "usage",
            "type": "number",
            "title": {
              "en": "Usage this hour in kWh",
              "no": "Forbruk denne timen i kWh"
            },
            "example": 3.2
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=amsreader"
          },
          {
            "name": "kwh",
            "type": "number",
            "min": 0,
            "step": 0.1,
            "placeholder": {
              "en": "kWh"
            }
          }
        ],
        "hint": {
          "en": "Fires once each hour, when the energy used so far this hour passes the limit.",
          "no": "Starter én gang i timen, når energien brukt så langt denne timen passerer grensen."
        }
      },
      {
        "id": "threshold_changed",
        "title": {
          "en": "Capacity step changed",
          "no": "Effekttrinnet endret seg"
        },
        "tokens": [
          {
            "name": "threshold",
            "type": "number",
            "title": {
              "en": "Capacity step in kW",
              "no": "Effekttrinn i kW"
            },
            "example": 10
          }
        ],
        "hint": {
          "en": "The capacity step is set up on the reader and follows the average of the highest hours this month.",
          "no": "Effekttrinnene settes opp på leseren og følger snittet av månedens høyeste timer."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=amsreader"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "meter_ok",
        "title": {
          "en": "Meter !{{is|is not}} sending data",
          "no": "Måleren !{{sender|sender ikke}} data"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=amsreader"
          }
        ]
      },
      {
        "id": "hour_usage_above",
        "title": {
          "en": "Usage this hour is !{{above|not above}} a limit",
          "no": "Forbruket denne timen er !{{over|ikke over}} en grense"
        },
        "titleFormatted": {
          "en": "Usage this hour is !{{above|not above}} [[kwh]] kWh",
          "no": "Forbruket denne timen er !{{over|ikke over}} [[kwh]] kWh"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=amsreader"
          },
          {
            "name": "kwh",
            "type": "number",
            "min": 0,
            "step": 0.1,
            "placeholder": {
              "en": "kWh"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "AMS reader",
        "no": "AMS-leser"
      },
      "class": "sensor",
      "capabilities": [
        "measure_power",
        "meter_power.imported",
        "meter_power.exported",
        "ams_day_import",
        "ams_day_export",
        "measure_voltage.l1",
        "measure_voltage.l2",
        "measure_voltage.l3",
        "measure_current.l1",
        "measure_current.l2",
        "measure_current.l3",
        "ams_hour_usage",
        "ams_month_max",
        "ams_threshold"
      ],
      "capabilitiesOptions": {
        "meter_power.imported": {
          "title": {
            "en": "Imported energy",
            "no": "Importert energi"
          },
          "decimals": 2
        },
        "meter_power.exported": {
          "title": {
            "en": "Exported energy",
            "no": "Eksportert energi"
          },
          "decimals": 2
        },
        "measure_voltage.l1": {
          "title": {
            "en": "Voltage L1",
            "no": "Spenning L1"
          }
        },
        "measure_voltage.l2": {
          "title": {
            "en": "Voltage L2",
            "no": "Spenning L2"
          }
        },
        "measure_voltage.l3": {
          "title": {
            "en": "Voltage L3",
            "no": "Spenning L3"
          }
        },
        "measure_current.l1": {
          "title": {
            "en": "Current L1",
            "no": "Strøm L1"
          }
        },
        "measure_current.l2": {
          "title": {
            "en": "Current L2",
            "no": "Strøm L2"
          }
        },
        "measure_current.l3": {
          "title": {
            "en": "Current L3",
            "no": "Strøm L3"
          }
        },
        "measure_power.l1": {
          "title": {
            "en": "Power L1",
            "no": "Effekt L1"
          }
        },
        "measure_power.l2": {
          "title": {
            "en": "Power L2",
            "no": "Effekt L2"
          }
        },
        "measure_power.l3": {
          "title": {
            "en": "Power L3",
            "no": "Effekt L3"
          }
        }
      },
      "energy": {
        "cumulative": true,
        "cumulativeImportedCapability": "meter_power.imported",
        "cumulativeExportedCapability": "meter_power.exported"
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "pair": [
        {
          "id": "connect"
        }
      ],
      "settings": [
        {
          "id": "address",
          "type": "text",
          "label": {
            "en": "IP address or host name",
            "no": "IP-adresse eller vertsnavn"
          },
          "value": "",
          "hint": {
            "en": "The address of the AMS reader on your network. Readers found automatically follow a new address by themselves.",
            "no": "Adressen til AMS-leseren på nettverket. Lesere som ble funnet automatisk, følger selv med når adressen endrer seg."
          }
        },
        {
          "id": "username",
          "type": "text",
          "label": {
            "en": "Username",
            "no": "Brukernavn"
          },
          "value": "",
          "hint": {
            "en": "Only needed when the web page of the reader is password protected.",
            "no": "Trengs bare når nettsiden til leseren er passordbeskyttet."
          }
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password",
            "no": "Passord"
          },
          "value": ""
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Poll interval",
            "no": "Oppdateringsintervall"
          },
          "units": {
            "en": "seconds",
            "no": "sekunder"
          },
          "value": 10,
          "min": 5,
          "max": 300,
          "hint": {
            "en": "How often Homey reads the reader. The meter sends new values every 2 to 10 seconds.",
            "no": "Hvor ofte Homey leser av leseren. Måleren sender nye verdier hvert 2. til 10. sekund."
          }
        },
        {
          "id": "estimate_l2",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Estimate current L2",
            "no": "Anslå strøm L2"
          },
          "hint": {
            "en": "Meters on IT networks (230 V without neutral) do not measure the current on L2. When this is on, it is estimated from L1 and L3 as if the load were evenly spread over the phases, so treat it as a guide only.",
            "no": "Målere på IT-nett (230 V uten nøytralleder) måler ikke strømmen på L2. Når dette er på, anslås den ut fra L1 og L3 som om lasten var jevnt fordelt på fasene, så se på den som en pekepinn."
          }
        }
      ],
      "images": {
        "small": "/drivers/amsreader/assets/images/small.png",
        "large": "/drivers/amsreader/assets/images/large.png",
        "xlarge": "/drivers/amsreader/assets/images/xlarge.png"
      },
      "discovery": "amsreader",
      "id": "amsreader"
    }
  ],
  "capabilities": {
    "ams_day_export": {
      "type": "number",
      "units": {
        "en": "kWh"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "title": {
        "en": "Exported today",
        "no": "Eksportert i dag"
      },
      "icon": "/assets/day.svg"
    },
    "ams_day_import": {
      "type": "number",
      "units": {
        "en": "kWh"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "title": {
        "en": "Imported today",
        "no": "Importert i dag"
      },
      "icon": "/assets/day.svg"
    },
    "ams_hour_usage": {
      "type": "number",
      "title": {
        "en": "Usage this hour",
        "no": "Forbruk denne timen"
      },
      "units": {
        "en": "kWh"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/hour.svg"
    },
    "ams_month_max": {
      "type": "number",
      "title": {
        "en": "Capacity average this month",
        "no": "Effektsnitt denne måneden"
      },
      "units": {
        "en": "kW"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/peak.svg"
    },
    "ams_threshold": {
      "type": "number",
      "title": {
        "en": "Capacity step",
        "no": "Effekttrinn"
      },
      "units": {
        "en": "kW"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/peak.svg"
    }
  },
  "discovery": {
    "amsreader": {
      "type": "ssdp",
      "ssdp": {
        "search": "ssdp:all"
      },
      "id": "{{headers.usn}}",
      "conditions": [
        [
          {
            "field": "headers.server",
            "match": {
              "type": "regex",
              "value": "AMS reader"
            }
          }
        ]
      ]
    },
    "amsreader-mdns": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "http",
        "protocol": "tcp"
      },
      "id": "{{name}}",
      "conditions": [
        [
          {
            "field": "name",
            "match": {
              "type": "regex",
              "value": "^ams-"
            }
          }
        ]
      ]
    }
  }
}